# LLM Quality Tester Configuration
# Set to 'false' to make calls to real OpenAI-compatible endpoint
USE_MOCK_LLM=true

# Model Configuration
LLM_MODEL=gpt-4o-mini
LLM_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=your_openai_api_key_here

# DeepEval Configuration
DEEPEVAL_EVALUATION_MODEL=gpt-4o-mini
DEEPEVAL_TELEMETRY_OPT_OUT=true

# Quality Thresholds
CORRECTNESS_THRESHOLD=0.70
HALLUCINATION_THRESHOLD=0.30
MAX_LATENCY_THRESHOLD_MS=3000


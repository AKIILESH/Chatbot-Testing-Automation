# ProcureQA Configuration Template
# Configure your Groq API Key and Model

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
# Alternative available models on Groq: openai/gpt-oss-120b, allam-2-7b, llama-3.3-70b-versatile

# DeepEval / Evaluation Configuration
DEEPEVAL_EVALUATION_MODEL=gpt-4o-mini
DEEPEVAL_TELEMETRY_OPT_OUT=true

# SLA & Quality Thresholds
CORRECTNESS_THRESHOLD=0.70
HALLUCINATION_THRESHOLD=0.30
MAX_LATENCY_THRESHOLD_MS=2500
